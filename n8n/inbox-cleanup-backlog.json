      "name": "Get Inbox Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        240,
        160
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "PLACEHOLDER_GMAIL",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// ===== REGLAS EDITABLES =====\nconst RULES = {\n  trashSenders:   ['support@getontop.com'],                       // copias de tickets Zendesk\n  trashScript:    { sender: 'noreply-apps-scripts-notifications@google.com', subject: /sync zendesk users/i },\n  trashZoom:      { sender: 'no-reply@zoom.us', subject: /(has joined your meeting|se ha unido a tu reuni)/i },\n  collabSenders:  ['drive-shares-dm-noreply@google.com', 'comments-noreply@docs.google.com', 'calendar-notification@google.com'],\n  infoSenders:    ['notifications@mail.granola.ai', 'events@send.zapier.com'],\n};\nconst DRY_RUN = true;   // true = solo clasifica (no actua). Cambia a false para ejecutar de verdad.\nconst seen = new Set();\n// =============================\nconst out = [];\nfor (const item of $input.all()) {\n  const from = String(item.json.From || '').toLowerCase();\n  const subject = String(item.json.Subject || '');\n  const has = (list) => list.some(s => from.includes(s));\n  let category = 'none', reason = 'Sin regla: se deja en la bandeja';\n\n  if (has(RULES.trashSenders)) { category = 'trash'; reason = 'Copia de ticket Zendesk'; }\n  else if (from.includes(RULES.trashScript.sender) && RULES.trashScript.subject.test(subject)) { category = 'trash'; reason = 'Fallo Apps Script Sync Zendesk Users'; }\n  else if (from.includes(RULES.trashZoom.sender) && RULES.trashZoom.subject.test(subject)) { category = 'trash'; reason = 'Aviso Zoom: alguien se unio'; }\n  else if (has(RULES.collabSenders)) { category = 'collab'; reason = 'Colaboracion'; }\n  else if (has(RULES.infoSenders)) { category = 'info'; reason = 'Informativo / baja prioridad'; }\n\n  // un solo item por hilo para no trashear dos veces\n  if (category !== 'none') { if (seen.has(item.json.threadId)) continue; seen.add(item.json.threadId); }\n  const intended = category;\n  if (DRY_RUN && category !== 'none') category = 'dry-run';\n  out.push({ json: { ...item.json, category, intended, reason, dryRun: DRY_RUN } });\n}\nreturn out;"
      },
      "name": "Transform Classify Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
